# Copy to .env.local (local mode). For Inngest Cloud, put the Inngest keys in .env.cloud.local:
# `CODECLIMB_ENV=cloud` loads it first, so its values win over .env.local. Both files are gitignored.

# --- Pi: coder and reviewer models (`models`, `reviewer_model`) ---
# Set the key of every provider a config names as `<provider>/<id>`.
# Instead of a key, `npx pi` then `/login <provider>` stores credentials in ~/.pi/agent/auth.json.
ANTHROPIC_API_KEY=           # anthropic/<id>
OPENCODE_API_KEY=            # opencode/<id> (Zen) and opencode-go/<id> (Go): one key for both
COPILOT_GITHUB_TOKEN=        # github-copilot/<id>
# CODECLIMB_PI_AUTH_PATH=    # another auth.json than ~/.pi/agent/auth.json

# --- Dev: models the program under evaluation calls (`allowed_models`) ---
# Called only through the metering proxy, which holds the key; it never enters a sandbox.
OPENROUTER_API_KEY=          # openrouter/<id>
# OPENROUTER_BASE_URL=       # another OpenRouter endpoint (default https://openrouter.ai/api), for tests

# --- Inngest ---
# Local: `npm run worker` and `npm run run-night` set INNGEST_DEV=1 and talk to `npm run dev:inngest`.
# Cloud (.env.cloud.local): both keys required; INNGEST_DEV must stay unset.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# --- Worker API and metering proxy (defaults shown) ---
# CODECLIMB_API_HOST=127.0.0.1
# CODECLIMB_API_PORT=7421
# CODECLIMB_WORKER_TOKEN=    # bearer token for the worker API; required when the API binds off loopback
# CODECLIMB_WORKER_URL=      # where the app reaches the worker API (default http://127.0.0.1:7421)
# CODECLIMB_PROXY_HOST=127.0.0.1  # on Linux Docker, the docker0 address (e.g. 172.17.0.1)
# CODECLIMB_PROXY_PORT=      # random locally; 7422 in cloud mode, for the tunnel
# CODECLIMB_METER_URL=       # public proxy URL ending in /v1 for Inngest sandboxes, if not using `npm run tunnel`
# CODECLIMB_WORKER_ID=codeclimb-worker-local  # the connect() worker's instance id
# CODECLIMB_ROOT=          # checkout the worker resolves config paths against (default: cwd)
