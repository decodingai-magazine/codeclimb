# Copy to .env (gitignored). One file for every mode: local and cloud read the same .env.

# --- Models ---
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- LangSmith ---
# `npm run dev` (langgraph dev) needs the key (free Developer plan); tracing is optional.
# Same key for LangSmith Sandboxes (`langsmith/sandbox`) and tracing.
LANGSMITH_API_KEY=           # Settings > API Keys > personal access token (lsv2_...)
LANGSMITH_TRACING=true       # false: no traces sent (saves the 5k/month Developer quota)
LANGSMITH_PROJECT=codeclimb-dev  # tracing project the runs appear under
# LANGSMITH_WORKSPACE_ID=    # only if the key can reach more than one workspace
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # EU: https://eu.api.smith.langchain.com
