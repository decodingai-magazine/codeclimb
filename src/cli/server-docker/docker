#!/bin/sh
# The `docker` that `npm run server` puts first on PATH for `langgraphjs up` (spec: Deployment and environment).
# langgraphjs up pipes its generated compose file on stdin and publishes the server's port 8000 as `<port>:8000`, on
# every interface of the host; a compose override can only add a binding, not replace it. This rewrites that one line
# to `127.0.0.1:<port>:8000` and passes everything else to the real docker unchanged.
set -eu
real="${CODECLIMB_REAL_DOCKER:?CODECLIMB_REAL_DOCKER is not set}"
if [ "${1:-}" = "compose" ]; then
	for a in "$@"; do
		if [ "$a" = "-" ]; then
			sed -E 's/^([[:space:]]*-[[:space:]]*)"?([0-9]+):8000"?[[:space:]]*$/\1"127.0.0.1:\2:8000"/' | "$real" "$@"
			exit $?
		fi
	done
fi
exec "$real" "$@"
