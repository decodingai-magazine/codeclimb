# The CodeClimb worker for an always-on host: connect() to Inngest Cloud, Pi,
# score_cmd (python3) and the worker API + metering proxy on one port ($PORT).
# Sandboxes are Inngest Sandboxes; there is no Docker inside. Mount a volume at
# /app/runs: crash recovery and the app read the night's files from it.
#   docker build -f Dockerfile.worker -t codeclimb-worker .
FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends git python3 ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && git config --system user.name codeclimb \
  && git config --system user.email codeclimb@localhost

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY codeclimb/ codeclimb/
COPY inngest/ inngest/
COPY scripts/ scripts/
COPY scenarios/ scenarios/
COPY configs/ configs/
COPY tsconfig.json ./

# CODECLIMB_ENV=cloud makes the worker refuse to start without the Inngest keys.
ENV CODECLIMB_ENV=cloud \
    CODECLIMB_ROOT=/app \
    CODECLIMB_API_HOST=0.0.0.0 \
    PORT=8080 \
    NODE_ENV=production
EXPOSE 8080
VOLUME ["/app/runs"]
CMD ["node_modules/.bin/tsx", "--import", "@inngest/otel/node", "scripts/worker.ts"]
