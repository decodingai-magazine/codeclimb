# Copy to .env (gitignored). The CLI, the worker API and the Agent Server all read this one file.

# --- Models ---
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- LangSmith ---
# The key (free Developer plan) is required: `npm run server` does not boot without it. Tracing and feedback are optional.
# With LANGSMITH_TRACING=false (mock nights, CI) nothing is traced; the key is still needed.
# The endpoint must match the key's region: a key from the other region gets 403 with an empty message.
LANGSMITH_API_KEY=           # Settings > API Keys > personal access token (lsv2_...)
LANGSMITH_TRACING=true       # false: no traces sent (saves the 5k/month Developer quota)
LANGSMITH_PROJECT=codeclimb      # tracing project the runs appear under
# LANGSMITH_WORKSPACE_ID=    # only if the key can reach more than one workspace
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # US (default). EU keys: https://eu.api.smith.langchain.com
