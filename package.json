{
  "name": "codeclimb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:inngest": "npx --ignore-scripts=false --allow-scripts=inngest-cli inngest-cli@latest dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "worker": "INNGEST_DEV=1 tsx --import @inngest/otel/node scripts/worker.ts",
    "run-night": "INNGEST_DEV=1 tsx scripts/run-night.ts",
    "worker:cloud": "CODECLIMB_ENV=cloud tsx --import @inngest/otel/node scripts/worker.ts",
    "run-night:cloud": "CODECLIMB_ENV=cloud tsx scripts/run-night.ts",
    "tunnel": "ngrok http 127.0.0.1:${CODECLIMB_PROXY_PORT:-7422}",
    "validate-results": "tsx scripts/validate-results.ts",
    "build:baseline": "docker build -t autocode-base scenarios/datenorm",
    "build:dataset": "python3 scenarios/datenorm/tools/build_dataset.py --out scenarios/datenorm/dataset",
    "report": "tsx scripts/report.ts",
    "export": "tsx scripts/export.ts",
    "build:baseline:hard": "docker build -t autocode-base-hard scenarios/datenorm-hard",
    "build:dataset:hard": "python3 scenarios/datenorm-hard/tools/build_dataset.py --out scenarios/datenorm-hard/dataset",
    "build:baseline:capitals": "docker build -t autocode-base-capitals scenarios/capitals",
    "test": "tsx --test codeclimb/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "inngest": "^4.25.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@inngest/otel": "^0.2.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
