{
  "name": "codeclimb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "tsx src/cli/server.ts",
    "server:logs": "tsx src/cli/server.ts logs",
    "server:stop": "tsx src/cli/server.ts stop",
    "dev": "next dev web -H 127.0.0.1",
    "build:app": "next build web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "build:image": "docker build -t codeclimb-python -f docker/python.Dockerfile docker",
    "build:image:graphrag": "npm run build:image && docker build -t codeclimb-graphrag -f docker/graphrag.Dockerfile scenarios/graphrag",
    "build:dataset": "python3 scenarios/datenorm/scripts/build_dataset.py --out scenarios/datenorm/gold",
    "build:dataset:hard": "python3 scenarios/datenorm-hard/scripts/build_dataset.py --out scenarios/datenorm-hard/gold",
    "build:scenario:overfit": "python3 scenarios/datenorm/scripts/build_overfit.py --out generated/datenorm-overfit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "run-night": "tsx src/cli/run-night.ts",
    "validate-results": "tsx src/cli/validate-results.ts",
    "lessons": "tsx src/cli/lessons.ts",
    "export": "tsx src/cli/export.ts",
    "api": "tsx src/cli/api.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@langchain/core": "1.3.7",
    "@langchain/langgraph": "1.7.3",
    "@langchain/langgraph-sdk": "1.15.0",
    "@opentelemetry/api": "1.10.0",
    "langsmith": "0.12.0",
    "next": "16.4.2",
    "pi-web-access": "0.47.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "1.7.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
